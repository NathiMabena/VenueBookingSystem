@model VenueBookingSystem.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="col-md-8">

        <div class="card shadow border-0 rounded-4">
            <div class="card-header bg-light border-bottom-0 py-4 text-center">
                <h2 class="fw-bold text-primary mb-0">@Model.EventName</h2>
                <p class="text-muted mb-0">Event ID: #@Model.EventId</p>
            </div>

            <div class="card-body p-5">
                <dl class="row mb-0 fs-5">

                    <dt class="col-sm-4 text-muted">Date & Time</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.EventDate.ToString("f")</dd>

                    <dt class="col-sm-4 text-muted mt-3">Description</dt>
                    <dd class="col-sm-8 mt-3">@Model.Description</dd>

                    <dt class="col-sm-4 text-muted mt-4">Assigned Venue</dt>
                    <dd class="col-sm-8 mt-4">
                        @if (Model.Venue != null)
                        {
                            <span class="badge bg-success fs-6 py-2 px-3">@Model.Venue.VenueName</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark fs-6 py-2 px-3">Pending Venue</span>
                        }
                    </dd>
                </dl>
            </div>

            <div class="card-footer bg-white border-top text-center py-4">
                <a asp-action="Edit" asp-route-id="@Model?.EventId" class="btn btn-primary btn-lg rounded-pill px-4 mx-2">Edit Event</a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4 mx-2">Back to List</a>
            </div>
        </div>

    </div>
</div>