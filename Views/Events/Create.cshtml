@model VenueBookingSystem.Models.Event

@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-5 mb-5 d-flex justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-primary text-white text-center py-4 border-0">
                <h2 class="fw-bold mb-0">Create New Event</h2>
                <p class="mb-0 text-white-50">Fill in the event details below</p>
            </div>

            <div class="card-body p-4 p-md-5 bg-white">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="EventName" class="form-control rounded-3" placeholder="Event Name" />
                        <label asp-for="EventName" class="text-muted">Event Name</label>
                        <span asp-validation-for="EventName" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="EventDate" class="form-control rounded-3" placeholder="Event Date" />
                        <label asp-for="EventDate" class="text-muted">Date & Time</label>
                        <span asp-validation-for="EventDate" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <textarea asp-for="Description" class="form-control rounded-3" placeholder="Description" style="height: 100px"></textarea>
                        <label asp-for="Description" class="text-muted">Description</label>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <select asp-for="VenueId" class="form-select rounded-3" asp-items="ViewBag.VenueId">
                            <option value="">-- Select a Venue (Optional) --</option>
                        </select>
                        <label asp-for="VenueId" class="text-muted">Assigned Venue</label>
                        <span asp-validation-for="VenueId" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <input type="submit" value="Create Event" class="btn btn-primary btn-lg rounded-pill fw-bold" />
                        <a asp-action="Index" class="btn btn-light btn-lg rounded-pill text-muted mt-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}