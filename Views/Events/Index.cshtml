@model IEnumerable<VenueBookingSystem.Models.Event>

@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container mt-4 mb-5">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm border-0 border-start border-danger border-5 mb-4" role="alert">
            <h5 class="alert-heading fw-bold mb-1"><i class="bi bi-shield-lock-fill"></i> Access Denied</h5>
            <p class="mb-0">@TempData["ErrorMessage"]</p>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h1 class="display-5 fw-bold text-primary"><i class="bi bi-calendar-event"></i> Upcoming Events</h1>
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm rounded-pill px-4">+ Create Event</a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-4 transition-hover">

                    @{
                        bool isPast = item.EventDate < DateTime.Now;
                        string headerBg = isPast ? "bg-secondary opacity-75" : "bg-gradient bg-primary";
                    }

                    <div class="card-header @headerBg text-white border-0 py-3 rounded-top-4 position-relative">
                        <h4 class="card-title fw-bold mb-0 text-truncate" style="padding-right: 60px;" title="@item.EventName">@item.EventName</h4>

                        @if (isPast)
                        {
                            <span class="badge bg-dark shadow-sm position-absolute top-50 end-0 translate-middle-y me-3">Passed</span>
                        }
                    </div>

                    <div class="card-body bg-light">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-white text-primary rounded-3 p-2 shadow-sm text-center me-3" style="min-width: 60px;">
                                <div class="fs-6 fw-bold text-uppercase">@item.EventDate.ToString("MMM")</div>
                                <div class="fs-4 fw-bolder lh-1">@item.EventDate.ToString("dd")</div>
                            </div>
                            <div>
                                <h6 class="mb-0 text-muted">Time</h6>
                                <p class="mb-0 fw-semibold">@item.EventDate.ToString("hh:mm tt")</p>
                            </div>
                        </div>

                        <p class="card-text text-muted mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @item.Description
                        </p>

                        <hr class="text-muted opacity-25" />

                        <p class="card-text">
                            <strong><i class="bi bi-geo-alt-fill text-danger"></i> Venue:</strong>
                            @if (item.Venue != null)
                            {
                                <span class="badge bg-success text-white">@item.Venue.VenueName</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending Venue</span>
                            }
                        </p>
                    </div>

                    <div class="card-footer bg-white border-top-0 pt-0 pb-3 text-center">
                        @if (!isPast)
                        {
                            <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Edit</a>
                        }
                        <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-outline-info btn-sm rounded-pill px-3 mx-1">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.EventId" class="btn btn-outline-danger btn-sm rounded-pill px-3">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .transition-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }
</style>