@model VenueBookingSystem.Models.Venue
@{
    ViewData["Title"] = "Delete Venue";
}
<div class="container mt-5 d-flex justify-content-center">
    <div class="col-md-8 col-lg-6">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger shadow-sm border-0 border-start border-danger border-5 mb-4" role="alert">
                <h4 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> Action Blocked</h4>
                <p class="mb-0">@TempData["ErrorMessage"]</p>
            </div>
        }
        <div class="card shadow border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-danger text-white text-center py-4 border-0">
                <h3 class="fw-bold mb-0">Are you sure?</h3>
                <p class="mb-0 text-white-50">This action cannot be undone.</p>
            </div>
            <div class="card-body p-4 p-md-5 text-center bg-white">
                <h2 class="text-dark fw-bold">@Model.VenueName</h2>
                <p class="text-muted mb-4">@Model.Location</p>
                <form asp-action="Delete">
                    <input type="hidden" asp-for="VenueId" />
                    <div class="d-grid gap-2 mt-4">
                        <input type="submit" value="Yes, Delete Venue" class="btn btn-danger btn-lg rounded-pill fw-bold" />
                        <a asp-action="Index" class="btn btn-light btn-lg rounded-pill text-muted mt-2">No, Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>