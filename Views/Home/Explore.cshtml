@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h2 class="display-5 fw-bold">
            What would you like to manage <span class="glow-pink">today?</span></h2>
        <p class="text-muted text-uppercase tracking-wide">Select a category below</p>
    </div>

    <div class="row g-4 justify-content-center mt-3">

        <div class="col-md-4">
            <div class="card h-100 shadow border-0 rounded-4 text-center p-4 hover-zoom">
                <div class="card-body d-flex flex-column">
                    <h1 class="display-1 mb-3">🏢</h1>
                    <h3 class="card-title fw-bold">Venues</h3>
                    <p class="text-muted mb-4">Add new locations, update capacities, and manage your property list.</p>
                    <a asp-controller="Venues" asp-action="Index" class="btn btn-outline-primary btn-lg mt-auto rounded-pill">Manage Venues</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow border-0 rounded-4 text-center p-4">
                <div class="card-body d-flex flex-column">
                    <h1 class="display-1 mb-3">📅</h1>
                    <h3 class="card-title fw-bold">Events</h3>
                    <p class="text-muted mb-4">Create upcoming events, set dates, and assign them to your venues.</p>
                    <a asp-controller="Events" asp-action="Index" class="btn btn-outline-success btn-lg mt-auto rounded-pill">Manage Events</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow border-0 rounded-4 text-center p-4">
                <div class="card-body d-flex flex-column">
                    <h1 class="display-1 mb-3">🎟️</h1>
                    <h3 class="card-title fw-bold">Bookings</h3>
                    <p class="text-muted mb-4">View client reservations and link events to their confirmed venues.</p>
                    <a asp-controller="Bookings" asp-action="Index" class="btn btn-outline-info btn-lg mt-auto rounded-pill">Manage Bookings</a>
                </div>
            </div>
        </div>

    </div>
</div>
<style>
    .glow-pink {
        /* A light pink base color so the text remains readable */
        color: #ffb3d9;
        /* The glowing animation */
        animation: neon-pulse 1.5s infinite alternate;
    }

    /* Use double @@ so Razor doesn't confuse it with C# */
    @@keyframes neon-pulse {
        from {
            text-shadow: 0 0 5px #ff1493, 0 0 10px #ff1493, 0 0 20px #ff1493;
        }

        to {
            text-shadow: 0 0 5px #ff1493, 0 0 10px #ff1493, 0 0 20px #ff1493, 0 0 30px #ff1493, 0 0 40px #ff1493;
        }
    }
</style>