@model VenueBookingSystem.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="card shadow border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-danger text-white text-center py-4 border-0">
                <h3 class="fw-bold mb-0">Are you sure?</h3>
                <p class="mb-0 text-white-50">This action cannot be undone.</p>
            </div>

            <div class="card-body p-4 p-md-5 text-center bg-white">
                <h3 class="text-dark fw-bold mb-1">Cancel Booking #@Model.BookingId.ToString("D4")?</h3>
                <p class="text-muted mb-2">Event: <strong>@(Model.Event?.EventName)</strong></p>
                <p class="text-muted mb-4">Venue: <i class="bi bi-geo-alt-fill text-danger"></i> @(Model.Venue?.VenueName)</p>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="BookingId" />
                    <div class="d-grid gap-2 mt-4">
                        <input type="submit" value="Yes, Cancel Booking" class="btn btn-danger btn-lg rounded-pill fw-bold" />
                        <a asp-action="Index" class="btn btn-light btn-lg rounded-pill text-muted mt-2">No, Keep It</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>