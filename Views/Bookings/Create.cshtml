@model VenueBookingSystem.Models.Booking

@{
    ViewData["Title"] = "New Booking";
}

<div class="container mt-5 mb-5 d-flex justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-info text-white text-center py-4 border-0">
                <h2 class="fw-bold mb-0">New Booking</h2>
                <p class="mb-0 text-white-50">Link an event to a venue</p>
            </div>

            <div class="card-body p-4 p-md-5 bg-white">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-floating mb-3">
                        <select asp-for="EventId" class="form-select rounded-3" asp-items="ViewBag.EventId">
                            <option value="">-- Select an Event --</option>
                        </select>
                        <label asp-for="EventId" class="text-muted">Event</label>
                    </div>


                    <div class="d-grid gap-2">
                        <input type="submit" value="Confirm Booking" class="btn btn-info text-white btn-lg rounded-pill fw-bold" />
                        <a asp-action="Index" class="btn btn-light btn-lg rounded-pill text-muted mt-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}